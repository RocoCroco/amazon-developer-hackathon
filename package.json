{
  "name": "recall-guardian",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "MCP server that turns Alexa+ into a recall guardian for everything in the home",
  "workspaces": [
    "packages/*",
    "infra"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test:live": "node scripts/test-live.mjs",
    "e2e:deployed": "node scripts/smoke-deployed.mjs && node scripts/verify-watcher.mjs && node scripts/verify-simulator.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.11.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4"
  }
}
