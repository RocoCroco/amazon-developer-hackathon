{
  "name": "recall-guardian",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "recall-guardian",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "infra"
      ]
    },
    "infra": {
      "name": "@recall-guardian/infra",
      "version": "0.1.0",
      "license": "MIT"
    },
    "node_modules/@recall-guardian/infra": {
      "resolved": "infra",
      "link": true
    },
    "node_modules/@recall-guardian/mcp-server": {
      "resolved": "packages/mcp-server",
      "link": true
    },
    "node_modules/@recall-guardian/simulator": {
      "resolved": "packages/simulator",
      "link": true
    },
    "packages/mcp-server": {
      "name": "@recall-guardian/mcp-server",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/simulator": {
      "name": "@recall-guardian/simulator",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
